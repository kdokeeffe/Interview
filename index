  --text:#d0e0f0;--text-bright:#e8f0ff;--text-dim:#6888aa;
  --neon:#00aaff;--cyan:#00e5ff;--green:#00ff88;--amber:#ffaa00;--red:#ff4466;--purple:#aa66ff;
}
html.light{
  --bg:#edf4fb;--bg-grad:linear-gradient(170deg,#f7fbff 0%,#e8f2fc 45%,#dfeefa 75%,#f7fbff 100%);
  --surface:rgba(255,255,255,.88);--border:rgba(0,90,160,.15);--border-glow:rgba(0,110,190,.25);
  --text:#29425c;--text-bright:#102a43;--text-dim:#59748f;
  --neon:#006fbd;--cyan:#008da6;--green:#008f58;--amber:#a96300;--red:#c62e4d;--purple:#7045c7;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;color:var(--text);font:16px/1.65 Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased;background:var(--bg);min-height:100vh}
.bg{position:fixed;inset:0;background:var(--bg-grad);z-index:-4}
.grid{position:fixed;inset:0;z-index:-3;background-image:linear-gradient(rgba(80,180,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(80,180,255,.035) 1px,transparent 1px);background-size:60px 60px}
.orb{position:fixed;width:340px;height:340px;border-radius:50%;filter:blur(100px);opacity:.08;z-index:-2;pointer-events:none}
.o1{background:var(--cyan);left:-300px;top:12%;animation:orbit1 18s ease-in-out infinite alternate}
.o2{background:var(--purple);right:-300px;top:45%;animation:orbit2 22s ease-in-out infinite alternate}
.o3{background:var(--green);left:-280px;bottom:-100px;animation:orbit1 26s ease-in-out infinite alternate-reverse}
@keyframes orbit1{to{transform:translate(110px,80px) scale(1.12)}}
@keyframes orbit2{to{transform:translate(-120px,-70px) scale(.9)}}
header{position:sticky;top:0;z-index:100;background:rgba(3,13,32,.72);backdrop-filter:blur(20px);border-bottom:1px solid var(--border)}
html.light header{background:rgba(244,249,254,.8)}
.nav,.container{max-width:880px;margin:auto;padding-left:20px;padding-right:20px}
.nav{height:66px;display:flex;align-items:center;justify-content:space-between}
.brand{font-weight:700;color:var(--text-bright);letter-spacing:-.02em}
.controls{display:flex;gap:8px}
.icon-btn{width:40px;height:40px;border:1px solid var(--border);border-radius:11px;color:var(--text);background:var(--surface);cursor:pointer;font-size:18px;transition:.2s}
.icon-btn:hover{border-color:var(--border-glow);color:var(--cyan);box-shadow:0 0 18px rgba(0,170,255,.1)}
main{position:relative;z-index:1}
.hero{padding-top:95px;padding-bottom:70px}
.eyebrow{color:var(--neon);font-weight:600;letter-spacing:.08em;text-transform:uppercase;font-size:13px}
h1{font-size:clamp(48px,9vw,78px);line-height:1;letter-spacing:-.055em;margin:10px 0 12px;color:var(--text-bright)}
.role{font-size:20px;color:var(--cyan);font-weight:600;margin:0 0 32px}
.hero-line{max-width:760px;font-size:clamp(25px,4vw,37px);line-height:1.3;letter-spacing:-.025em;color:var(--text-bright);margin-bottom:34px}
.cta{display:inline-flex;align-items:center;gap:9px;padding:13px 20px;border-radius:10px;background:var(--neon);color:#001329!important;font-weight:700;text-decoration:none;box-shadow:0 0 25px rgba(0,170,255,.18);transition:.2s}
.cta:hover{background:var(--cyan);transform:translateY(-2px);box-shadow:0 0 28px rgba(0,229,255,.25)}
.sections{padding-bottom:80px}
.section{margin-bottom:14px;background:var(--surface);border:1px solid var(--border);border-radius:16px;overflow:hidden;transition:border-color .25s,box-shadow .25s}
.section:hover{border-color:var(--border-glow);box-shadow:0 8px 30px rgba(0,0,0,.1)}
.section-head{width:100%;display:flex;align-items:center;gap:14px;padding:20px 22px;background:none;border:0;color:var(--text-bright);cursor:pointer;text-align:left;font:600 17px Inter,sans-serif}
.number{display:grid;place-items:center;min-width:32px;height:32px;border-radius:50%;border:1px solid var(--neon);color:var(--cyan);font-size:13px}
.section-title{flex:1}
.toggle{color:var(--text-dim);font-size:24px;font-weight:400}
.section-body{display:grid;grid-template-rows:1fr;transition:grid-template-rows .32s ease}
.section-body>div{overflow:hidden}
.section-content{padding:0 22px 23px 68px;color:var(--text)}
.section.closed .section-body{grid-template-rows:0fr}
.section.closed .section-content{padding-top:0;padding-bottom:0}
.section-content p{margin:0 0 12px}
.section-content ul{padding-left:20px;margin:10px 0}
.section-content li{margin:7px 0}
.inferred{color:var(--text-dim);font-size:13px}
a{color:var(--neon);text-decoration:none}
a:hover{color:var(--cyan);text-shadow:0 0 10px rgba(0,229,255,.3)}
footer{border-top:1px solid var(--border);padding:30px 0 45px;color:var(--text-dim);font-size:13px;text-align:center}
@media(max-width:600px){
 .hero{padding-top:65px}
 .hero-line{font-size:26px}
 .section-content{padding-left:22px}
}
