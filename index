<script>
const root=document.documentElement;
const theme=document.getElementById("theme");
const sections=[...document.querySelectorAll(".section")];
const collapse=document.getElementById("collapse");

function updateThemeIcon(){
  theme.textContent=root.classList.contains("light")?"☾":"☀";
}
updateThemeIcon();

theme.addEventListener("click",()=>{
  root.classList.toggle("light");
  localStorage.setItem("theme",root.classList.contains("light")?"light":"dark");
  updateThemeIcon();
});

sections.forEach(section=>{
  const button=section.querySelector(".section-head");
  const icon=section.querySelector(".toggle");
  button.addEventListener("click",()=>{
    section.classList.toggle("closed");
    const open=!section.classList.contains("closed");
    button.setAttribute("aria-expanded",open);
    icon.textContent=open?"−":"+";
  });
});

let allOpen=true;
collapse.addEventListener("click",()=>{
  allOpen=!allOpen;
  sections.forEach(section=>{
    section.classList.toggle("closed",!allOpen);
    section.querySelector(".section-head").setAttribute("aria-expanded",allOpen);
    section.querySelector(".toggle").textContent=allOpen?"−":"+";
  });
  collapse.textContent=allOpen?"⊟":"⊞";
  collapse.title=allOpen?"Collapse all sections":"Expand all sections";
});

document.getElementById("year").textContent=new Date().getFullYear();
</script>
